---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import headerImage1 from "../../assets/images/header-image-1.jpg";
import mitarbeiterLaengleMichael from "../../assets/images/mitarbeiter-laengle-michael.png";
import mitarbeiterLaengleIris from "../../assets/images/mitarbeiter-laengle-iris.png";
import mitarbeiterAvatar from "../../assets/images/mitarbeiter-avatar.jpg";
---

<Layout>
  <div id="top" class="container">
    <!-- Hero-Bild &uuml;ber die gesamte Breite, direkt unter dem Menu -->
    <headerImage class="hero-section">
      <Image
        src={headerImage1}
        widths={[320, 640, 960, 1280]}
        sizes="(max-width: 575px) calc(100vw - 24px), (max-width: 767px) 516px, (max-width: 991px) 696px, (max-width: 1199px) 936px, (max-width: 1399px) 1116px, 1280px"
        class="w-100 hero-img"
        alt="Wohnzimmer mit Sofa und Einrichtung von Lüscher Wohnen AG"
      />
      <div class="hero-overlay text-center text-white">
        <h1 class="display-5 fw-bold text-dark">
          Willkommen bei L&uuml;scher Wohnen AG
        </h1>
        <p class="display-8 fw-bold text-dark">
          Ihr verl&auml;sslicher Partner f&uuml;r pers&ouml;nliche und
          innovative L&ouml;sungen
        </p>
        <a href="#kontakt" class="btn btn-brand btn-lg mt-2"
          >Kontakt aufnehmen</a
        >
      </div>
    </headerImage>

    <!-- Aktuells -->
    <!--
    <section id="aktuelles" class="py-5">
      <div class="container">
        <h2 class="section-title text-center mb-4">Aktuelles</h2>
        <div class="row align-items-center g-4">
          <div class="col-lg-12">
            <p class="text-center">Sehr geehrter Kunde, sehr geehrte Kundin</p>
            <p class="text-center">
              <strong
                >Wir haben vom 28.9. bis am 4.10.2026 Betriebsferien</strong
              >
            </p>
            <p class="text-center">
              Gerne bedienen wir Sie im Anschluss daran wieder in unserem
              Geschäft.
            </p>
            <p class="text-center">Danke für das Verständnis.</p>
            <p class="text-center">Die Geschäftsleitung.</p>
          </div>
        </div>
      </div>
    npm </section>


    <!-- Firmenvorstellung -->
    <section id="ueber-uns" class="py-5">
      <div class="container">
        <h2 class="section-title text-center mb-4">&Uuml;ber uns</h2>
        <div class="row align-items-center g-4">
          <div class="col-lg-6">
            <p>
              L&uuml;scher Wohnen AG steht seit mehr als 70 Jahren f&uuml;r
              Qualit&auml;t, Zuverl&auml;ssigkeit, Ideen und Innovationskraft.
            </p>
            <p>
              Wir begleiten unsere Kunden mit maßgeschneiderten L&ouml;sungen
              und einem erfahrenen Team, das t&auml;glich sein Bestes gibt, um
              Ihre Anforderungen zu erf&uuml;llen.
            </p>
            <p>
              Unser Anspruch ist es, langfristige Partnerschaften aufzubauen und
              gemeinsam mit unseren Kunden nachhaltig erfolgreich zu sein.
            </p>
          </div>
          <div class="col-lg-6">
            <ul class="list-unstyled">
              <li class="mb-2">
                <span class="badge-brand">✓</span> Über 70 Jahre Markterfahrung
              </li>
              <li class="mb-2">
                <span class="badge-brand">✓</span> Erfahrenes und motiviertes Team
              </li>
              <li class="mb-2">
                <span class="badge-brand">✓</span> Individuelle Beratung und Lösungen
              </li>
              <li class="mb-2">
                <span class="badge-brand">✓</span> Zuverlässiger Partner für Ihr Business
              </li>
              <li class="mb-2">
                <span class="badge-brand">✓</span> Lieferung und Montage durch eigene
                Leute
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="py-5">
      <div class="container">
        <h2 class="section-title text-center mb-5">Unsere Services</h2>
        <div class="row g-3">
          <div class="col-md-4">
            <div class="text-center p-4 h-100 service-card">
              <div class="service-icon">1</div>
              <h3 class="h5">Beratung</h3>
              <p class="small">
                Hatten Sie auch schon das Gefühl, bei einem Anliegen vom
                Verkäufer nicht ernst genommen zu werden?
              </p>
              <p class="small">
                Wir <strong>nehmen uns Zeit</strong> für all Ihre Anliegen, <strong
                  >wann und wo sie es wünschen</strong
                >
                .
              </p>
              <p class="small">
                Wie gross Ihr Anliegen auch ist, unsere <strong
                  >erfahrenen und bestens ausgebildeten Innenarchitekten und
                  Einrichtungsplaner</strong
                >
                können Sie mit ihrer Erfahrung und ihrem Einfühlungsvermögen unterstützen.
                Unser Ziel ist es, die
                <strong>für Sie richtige Lösung zu finden</strong>, sei das bei
                uns im Geschäft oder auch bei Ihnen zu Hause.
              </p>
              <p class="small">
                Unser Angebot deckt alle <strong
                  >Bereiche der Inneneinrichtung</strong
                > ab. Es sind dies:
              </p>
              <ul>
                <li class="small">Möbel und Polstermöbel</li>
                <li class="small">Esstische und Stühle</li>
                <li class="small">Betten und Bettwaren</li>
                <li class="small">Vorhänge und Vorhangsysteme</li>
                <li class="small">
                  Bodenbeläge aller Art (Teppich, Parkett, Laminat, Novilon,
                  Vinil, Kork usw.)
                </li>
                <li class="small">Lampen und Beleuchtungssysteme</li>
                <li class="small">Innenarchitektur und Bauführung</li>
              </ul>
            </div>
          </div>
          <div class="col-md-4">
            <div class="text-center p-4 h-100 service-card">
              <div class="service-icon">2</div>
              <h3 class="h5">Planung und Visualisierung</h3>
              <p class="small">
                Wir unterstützen Sie in <strong
                  >allen Phasen des Einrichtens</strong
                >. Angefangen bei der
                <strong
                  >Beratung, über die Planung inklusive Visualisierung Ihrer
                  Ideen bis zur Lieferung und Montage</strong
                >.
              </p>

              <p class="small">
                Nebst <strong
                  >Ersteinrichtungen sind vor allem Neueinrichtungen unsere
                  Stärke</strong
                >. Unsere
                <strong>langjährige Erfahrung und Expertise</strong> auf diesem Gebiet
                vermeiden unnötige Überraschungen und Aufwand.
              </p>

              <p class="small">
                Ihre individuellen Anforderungen und Wünsche und Ihre
                Zufriedenheit sind uns das wichtigste Anliegen.
              </p>

              <p class="small">
                Frdern Sie uns und lassen Sie sich überraschen.
              </p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="text-center p-4 h-100 service-card">
              <div class="service-icon">3</div>
              <h3 class="h5">Lieferung und Montage</h3>
              <p class="small">
                Unsere eigenen Mitarbeiter liefern und montieren die von Ihnen
                gekauften <strong
                  >M&ouml;bel, Polsterm&ouml;bel, Betten, Bodenbel&auml;ge und
                  Vorhangsysteme</strong
                >.
              </p>
              <p class="small">
                Anstatt Ihr Wochenprogramm auf den Kopf zu stellen oder den
                ganzen Tag auf die Lieferung zu warten,
                <strong>bestimmen Sie den exakten Lieferzeitpunkt</strong>. Das
                kann auch an einer Randzeit oder am Wochenende sein.
              </p>
              <p class="small">
                Bei uns stehen <strong
                  >P&uuml;nktlichkeit, Sauberkeit, Sorgfalt</strong
                > und Ihre
                <strong>Zufriedenheit</strong> an oberster Stelle.
              </p>
              <p class="small">
                Haben Sie nach der Auslieferung Ihrer M&ouml;bel W&uuml;nsche
                oder Fragen?<br />Wir sind Ihr
                <strong>Ansprechpartner</strong>, wenn es um die <strong
                  >Ergänzung Ihrer Einrichtung, Ersatzteile, Pflege oder weitere
                  Fragen rund um das Thema Einrichten</strong
                > geht.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mitarbeitervorstellung -->
    <section id="team" class="py-5 bg-light">
      <div class="container">
        <h2 class="section-title text-center mb-5">Unser Team</h2>
        <div class="row g-3">
          <div class="col-md-3">
            <div class="card team-card h-100 text-center border-0 shadow-sm">
              <Image
                src={mitarbeiterLaengleMichael}
                class="card-img-top team-img mx-auto mt-4"
                alt="Michael Längle"
              />
              <div class="card-body">
                <h5 class="card-title mb-0">Michael L&auml;ngle</h5>
                <p class="role">Gesch&auml;ftsf&uuml;hrer</p>
                <p class="card-text small">
                  Verantwortlich f&uuml;r Beratung, Planung, Verkauf,
                  Innenarchitektur, Strategie und Unternehmensf&uuml;hrung.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card team-card h-100 text-center border-0 shadow-sm">
              <Image
                src={mitarbeiterAvatar}
                class="card-img-top team-img mx-auto mt-4"
                alt="Christina Stahl"
              />
              <div class="card-body">
                <h5 class="card-title mb-0">Christina Stahl</h5>
                <p class="role">Verkauf</p>
                <p class="card-text small">
                  Verantwortlich f&uuml;r Beratung, Planung, Verkauf und
                  Innenarchitektur.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card team-card h-100 text-center border-0 shadow-sm">
              <Image
                src={mitarbeiterLaengleIris}
                class="card-img-top team-img mx-auto mt-4"
                alt="Iris Längle"
              />
              <div class="card-body">
                <h5 class="card-title mb-0">Iris L&auml;ngle</h5>
                <p class="role">Administration / Buchhaltung / Finanzen</p>
                <p class="card-text small">
                  Ihre Ansprechpartnerin f&uuml;r alle Kundenanliegen und die
                  internen Prozesse.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card team-card h-100 text-center border-0 shadow-sm">
              <Image
                src={mitarbeiterAvatar}
                class="card-img-top team-img mx-auto mt-4"
                alt="Vlavono Macoso"
              />
              <div class="card-body">
                <h5 class="card-title mb-0">Vlavono Macoso</h5>
                <p class="role">Lieferung und Montage</p>
                <p class="card-text small">
                  Ihre Ansprechpartnerin f&uuml;r alles im Zusammenhang mit
                  Lieferung und Montage.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
