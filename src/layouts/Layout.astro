---
import "../styles/bootstrap.scss";
import { Image } from "astro:assets";
import logo from "../../assets/images/logo.png";
---

<!doctype html>
<html lang="en" data-bs-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Möbel & Wohnberatung in Baden | Lüscher Wohnen AG</title>
    <meta
      name="description"
      content="Persönliche Wohnberatung, Möbel und Einrichtungsplanung in Baden. Lüscher Wohnen AG liefert und montiert Möbel, Betten, Vorhänge und Bodenbeläge."
    />
  </head>
  <body>
    <!-- Navigation: oben fixiert, mit Logo und Burger-Menu auf Mobile -->
    <nav
      class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm"
    >
      <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="#top">
          <Image
            src={logo}
            alt="Lüscher Wohnen AG Logo"
            height="60"
            class="me-2"
          />
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNav"
          aria-controls="mainNav"
          aria-expanded="false"
          aria-label="Navigation umschalten"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0 text-center">
            <li class="nav-item">
              <a class="nav-link active" href="/index.html#top">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/index.html#ueber-uns">Über uns</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/index.html#services">Services</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/index.html#team">Team</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/shop">Shop</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/index.html#kontakt">Kontakt</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <slot />
    <!-- Kontakt / Footer -->
    <footer id="kontakt" class="bg-dark text-light py-5">
      <div class="container">
        <div class="row g-4 align-items-start">
          <div class="col-lg-6 text-center text-lg-start">
            <h2 class="h4 mb-3">Kontakt</h2>
            <p class="mb-1">
              L&uuml;scher Wohnen AG &middot; Weite Gasse 9 &middot; 5400 Baden
            </p>
            <p class="mb-3">
              E-Mail: <a href="mailto:info@luescherwohnen.ch"
                >info@luescherwohnen.ch</a
              > &middot; Tel: +41 56 222 78 52
            </p>
            <h2 class="h4 mb-3">&Ouml;ffnungszeiten</h2>
            <p class="mb-3">
              Montag geschlossen<br />
              Dienstag bis Freitag 10:00 - 18:30 Uhr<br />
              Samstag 9:00 bis 16:00 Uhr<br />
              Sonntag geschlossen
            </p>
          </div>
          <div class="col-lg-6">
            <div class="ratio ratio-16x9">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2696.91293780538!2d8.30455207676559!3d47.472125997253514!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47906cc8633843c7%3A0x52fee39067589d6f!2sL%C3%BCscher%20Wohnen%20AG!5e0!3m2!1sde!2sch!4v1789058133526!5m2!1sde!2sch"
                title="Standort von Lüscher Wohnen AG in Baden"
                width="600"
                height="450"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
              >
              </iframe>
            </div>
          </div>
          <hr class="my-4 border-secondary" />
          <div class="text-center">
            <p class="small mb-2">
              <a href="/impressum">Impressum</a> &middot; <a href="/agb">AGB</a>
            </p>
            <p class="small mb-0">
              &copy; 2026 L&uuml;scher Wohnen AG. Alle Rechte vorbehalten.
            </p>
          </div>
        </div>
      </div>
      <script>
        // Import everything
        import "bootstrap/dist/js/bootstrap"; // Import only what you need
        // import 'bootstrap/js/dist/alert';
        // import 'bootstrap/js/dist/button';
        // import 'bootstrap/js/dist/carousel';
        // import 'bootstrap/js/dist/collapse';
        // import 'bootstrap/js/dist/dropdown';
        // import 'bootstrap/js/dist/modal';
        // import 'bootstrap/js/dist/offcanvas';
        // import 'bootstrap/js/dist/popover';
        // import 'bootstrap/js/dist/scrollspy';
        // import 'bootstrap/js/dist/tab';
        // import 'bootstrap/js/dist/toast';
        // import 'bootstrap/js/dist/tooltip';
      </script>
    </footer>
  </body>
</html>
